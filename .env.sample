# --- Option 1: Google Gemini (OpenAI Compatible Endpoint) ---
# VITE_LLM_PROVIDER="google" # Optional identifier
# VITE_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# VITE_API_KEY="YOUR_GEMINI_API_KEY" # <-- REPLACE THIS
# VITE_MODEL_NAME="gemini-1.5-flash-latest" # Or another compatible model

# --- Option 2: LM Studio (Default) ---
VITE_LLM_PROVIDER="lmstudio" # Optional identifier
VITE_API_BASE_URL="http://localhost:1234/v1"
VITE_API_KEY="lm-studio" # Usually not needed, LM Studio might use "lm-studio" or allow custom
VITE_MODEL_NAME="tessa-t1-14b" # Use the actual model identifier loaded in LM Studio

# --- Option 3: Ollama (Default) ---
# VITE_LLM_PROVIDER="ollama" # Optional identifier
# VITE_API_BASE_URL="http://localhost:11434/v1"
# VITE_API_KEY="" # Not needed by default, Ollama uses "ollama" if required
# VITE_MODEL_NAME="llama3:instruct" # <-- REPLACE with your desired Ollama model (e.g., llama3, mistral)

# --- Common Optional Parameters ---
# VITE_TEMPERATURE="0.7"
# VITE_MAX_TOKENS="2048"